{
  "name": "@edgemaker/core",
  "version": "1.4.1",
  "description": "TypeScript knowledge graph library inspired by Graphiti",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc && tsc-alias && cp -r src/prompts dist/",
    "build:with-types": "npm run types:generate && tsc && tsc-alias && cp -r src/prompts dist/",
    "dev": "tsc --watch",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:watch": "jest --watch",
    "test:watch:unit": "jest --config jest.unit.config.js --watch",
    "test:watch:integration": "jest --config jest.integration.config.js --watch",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:quick": "npm run test:unit",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build",
    "db:migrate": "supabase migration new",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db seed",
    "types:generate": "supabase gen types typescript --linked > src/types/supabase.ts",
    "supabase:start": "supabase start",
    "test:user-search": "node scripts/test-user-search.js",
    "test:user-search:json": "node scripts/test-user-search.js --json",
    "supabase:stop": "supabase stop"
  },
  "keywords": [
    "ai",
    "knowledge-graph",
    "typescript",
    "postgresql",
    "graph"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "supabase": "^1.0.0",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/uuid": "^10.0.0",
    "bufferutil": "^4.0.9",
    "dotenv": "^16.3.0",
    "encoding": "^0.1.13",
    "openai": "^4.20.0",
    "p-limit": "^3.1.0",
    "p-retry": "^6.0.0",
    "utf-8-validate": "^6.0.5",
    "uuid": "^11.1.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.24.5"
  }
}
